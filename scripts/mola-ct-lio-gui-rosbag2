#!/usr/bin/env bash
# Runs continuous-time LiDAR-inertial odometry on any ROS 2 bag through
# mola-cli (online replay, 3D GUI).
#
# Not tied to a dataset: topics, /tf names and every pipeline knob come from
# the environment. Run with no arguments for the list. The shared plumbing is
# in lib/profiles/rosbag2.sh, along with the matching
# mola-ct-lio-cli-rosbag2 wrapper.
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
CTLIO_SCRIPTS_LIB="$SCRIPT_DIR/lib/dataset-profile.sh"
if [ ! -f "$CTLIO_SCRIPTS_LIB" ]; then
  CTLIO_SCRIPTS_LIB="$SCRIPT_DIR/../share/mola_ct_lio/scripts-lib/dataset-profile.sh"
fi
# shellcheck source=lib/dataset-profile.sh
source "$CTLIO_SCRIPTS_LIB"

CTLIO_MODE=gui
mola_ctlio_load_profile rosbag2 "$@" || exit $?
mola_ctlio_exec_gui
